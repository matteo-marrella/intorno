# Copia in .env (mai nel repo). Le variabili VITE_* finiscono nel renderer.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# TURN (opzionale ma consigliato per 4G / reti aziendali). Più URL separati da virgola.
VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

